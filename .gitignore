# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# mcp config (contains API keys)
.mcp.json
.nano-banana-config.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ANRE pipeline intermediate artifacts (regenerated by scripts/anre-match-companies.js)
/data/anre-match-proposal.json

# nano-banana generated images (copies go to public/images/*)
/generated_imgs/

# registru leaduri partajat cu firme partenere (mapare locală, nu se comite)
/data/partner-sheets.local.json

# social/ — 700+ MB de PNG/MP4/node_modules, rămâne local.
# Excepție: sursa Remotion (compozițiile .tsx + config), ~250 KB, merită în istoric.
# Starea reală a postărilor e în data/social-schedule.json, nu în folderul ăsta.
/social/*
!/social/remotion/
/social/remotion/*
!/social/remotion/src/
!/social/remotion/package.json
!/social/remotion/package-lock.json
!/social/remotion/remotion.config.ts
!/social/remotion/tsconfig.json

# python bytecode (scripturile de reel din social/)
__pycache__/
*.pyc
